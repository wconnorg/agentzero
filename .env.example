# Agent Zero's settings. Copy this file to .env and fill it in. .env is never committed.

# The bot's own token (Discord developer portal, Agent Zero's application, Bot tab).
DISCORD_TOKEN=

# The ZeroCorps server and its roles. In Discord, turn on Developer Mode
# (User Settings, Advanced), then right-click a server, role or channel and "Copy ID".
GUILD_ID=
VERIFIED_ROLE_ID=
ROOKIE_ROLE_ID=

# The verify channel: the bot posts its verify message there, and members react to it
# with ✅ to get Verified. Nothing else is posted there.
VERIFY_CHANNEL_ID=

# Optional. "Welcome @user!" goes here when someone joins. Empty: no welcome.
WELCOME_CHANNEL_ID=

# Optional. "Seeya @user!" goes here when someone leaves, is kicked or is banned.
# Empty: no goodbye.
GOODBYE_CHANNEL_ID=

# The website, and the shared secret: the same value as INTERNAL_API_SECRET on Vercel.
# Lost it? `npm run secret:new` makes a new one here, then replace Vercel's copy and redeploy.
ZEROCORPS_API_URL=https://zerocorps.org
INTERNAL_API_SECRET=

# Optional. Minutes between rank syncs (default 5).
SYNC_INTERVAL_MINUTES=

# Optional. A channel (a voice channel works best) whose name the bot keeps as
# "Academy Users: N", N being the Discord accounts linked on the website. The bot needs
# Manage Channels on that channel. Empty: off.
STATS_CHANNEL_ID=
