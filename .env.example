# Agent Zero's settings. Copy this file to .env and fill it in. .env is never committed.

# The bot's own token (Discord developer portal, Agent Zero's application, Bot tab).
DISCORD_TOKEN=

# The ZeroCorps server and its roles. In Discord, turn on Developer Mode
# (User Settings, Advanced), then right-click a server, role or channel and "Copy ID".
GUILD_ID=
VERIFIED_ROLE_ID=
# The Bronze rank's role. The rank was called Rookie until 2026-10-05: an older .env that
# still says ROOKIE_ROLE_ID works as it is, the role kept its id.
BRONZE_ROLE_ID=

# The verify channel: the bot posts its verify message there, and members react to it
# with ✅ to get Verified. Nothing else is posted there.
VERIFY_CHANNEL_ID=

# Optional. "Welcome @user!" goes here when someone joins. Empty: no welcome.
WELCOME_CHANNEL_ID=

# Optional. "Seeya @user!" goes here when someone leaves, is kicked or is banned.
# Empty: no goodbye.
GOODBYE_CHANNEL_ID=

# Optional, both or neither. The bot posts "react with 🔔 to receive analysis notifications"
# in the alerts channel; reacting gives the alerts role, removing the 🔔 takes it away. The
# bot needs the same permissions there as in the verify channel.
ALERTS_CHANNEL_ID=
ALERTS_ROLE_ID=

# The website, and the shared secret: the same value as INTERNAL_API_SECRET on Vercel.
# Lost it? `npm run secret:new` makes a new one here, then replace Vercel's copy and redeploy.
ZEROCORPS_API_URL=https://zerocorps.org
INTERNAL_API_SECRET=

# Optional. Minutes between rank syncs, and between reads of the accounts count (default 5).
SYNC_INTERVAL_MINUTES=

# Optional. A channel (a voice channel works best) whose name the bot keeps as "Users: N",
# N being how many ZeroCorps accounts there are (email-verified, with a username chosen).
# The bot needs Manage Channels on that channel. Empty: off.
STATS_CHANNEL_ID=

# Optional. The channel for the day's red and orange folders, posted every morning at 06:00
# Chicago time (two hours before the New York open) from Forex Factory's calendar. The bot
# needs View Channel, Send Messages and Read Message History there. Empty: off.
CALENDAR_CHANNEL_ID=

# Optional. The currencies the calendar covers, separated by commas (default USD).
CALENDAR_CURRENCIES=
